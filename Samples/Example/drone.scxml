<scxml version="1.0" xmlns="http://www.w3.org/2005/07/scxml" xmlns:editor="http://lepoopz.com/editor" initial="_initial_6610b">
  <datamodel>
    <data id="battery" expr="100" />
    <data id="missionName" expr="'Alpha'" />
  </datamodel>
  <state id="_initial_6610b" editor:x="0.0" editor:y="0.0">
    <transition target="Booting" />
  </state>
  <state id="Booting" editor:x="220.0" editor:y="0.0">
    <onentry>
      <log label="System" expr="'Booting drone OS...'" />
    </onentry>
    <transition event="boot_complete" target="Idle">
      <assign location="battery" expr="100" />
    </transition>
  </state>
  <state id="Idle" editor:x="440.0" editor:y="0.0">
    <transition event="start_mission" target="Active" />
    <transition event="critical_error" target="Error" />
  </state>
  <state id="Active" editor:x="660.0" editor:y="0.0">
    <onentry>
      <log label="Mission" expr="'Starting mission: ' + missionName" />
    </onentry>
    <initial id="_initial_12fed" editor:x="700.0" editor:y="120.0">
      <transition target="Takeoff" />
    </initial>
    <state id="Takeoff" editor:x="920.0" editor:y="120.0">
      <transition event="altitude_reached" target="Flying" />
    </state>
    <parallel id="Flying" editor:x="1140.0" editor:y="120.0">
      <transition event="battery_low" cond="battery &lt; 20" target="Landing" />
      <transition event="mission_complete" target="Landing" />
      <state id="Navigation" editor:x="1180.0" editor:y="240.0">
        <initial id="_initial_b73e6" editor:x="1220.0" editor:y="360.0">
          <transition target="Waypoints" />
        </initial>
        <state id="Waypoints" editor:x="1440.0" editor:y="360.0">
          <transition event="return_to_home" target="Returning" />
        </state>
        <state id="Returning" editor:x="1660.0" editor:y="360.0">
          <transition event="home_reached" target="Waypoints" />
        </state>
      </state>
      <state id="Camera" editor:x="1940.0" editor:y="240.0">
        <initial id="_initial_41cc8" editor:x="1980.0" editor:y="360.0">
          <transition target="Standby" />
        </initial>
        <state id="Standby" editor:x="2200.0" editor:y="360.0">
          <transition event="start_record" target="Recording" />
        </state>
        <state id="Recording" editor:x="2420.0" editor:y="360.0">
          <transition event="stop_record" target="Standby" />
          <onentry>
            <log label="Camera" expr="'Recording started'" />
          </onentry>
        </state>
      </state>
    </parallel>
    <state id="Landing" editor:x="2760.0" editor:y="120.0">
      <transition event="landed" target="Idle" />
    </state>
    <transition event="critical_error" target="Error" />
  </state>
  <final id="Error" editor:x="3040.0" editor:y="0.0">
    <onentry>
      <log label="System" expr="'Emergency shutdown initiated!'" />
    </onentry>
  </final>
</scxml>