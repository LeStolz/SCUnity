<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" xmlns:editor="http://lepoopz.com/editor" initial="Bottom">
  <state id="Top" editor:x="0.0" editor:y="0.0">
    <transition event="toggle" target="Bottom" />
  </state>
  <state id="Bottom" editor:x="220.0" editor:y="0.0">
    <transition event="toggle" target="Top" />
  </state>
</scxml>