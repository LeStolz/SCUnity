<?xml version="1.0" encoding="UTF-8"?>
<scxml
    xmlns="http://www.w3.org/2005/07/scxml"
    version="1.0"
    datamodel="ecmascript"
>
    <state id="Top">
        <transition event="toggle" target="Bottom"/>
    </state>

    <initial id="Bottom">
        <transition event="toggle" target="Top"/>
    </initial>
</scxml>